{
	"name": "@odinlabs-ai/pi-coding-agent",
	"version": "0.79.10-odin.1",
	"description": "Coding agent CLI with read, bash, edit, write tools and session management",
	"type": "module",
	"piConfig": {
		"configDir": ".pi"
	},
	"bin": {
		"pi": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"examples",
		"containerization.md",
		"CHANGELOG.md",
		"npm-shrinkwrap.json"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean packages/coding-agent",
		"build": "tsgo -p tsconfig.build.json && node ../../scripts/package-files.mjs chmod-cli packages/coding-agent && npm run copy-assets",
		"build:binary": "npm --prefix ../tui run build && npm --prefix ../ai run build && npm --prefix ../agent run build && npm run build && bun build --compile ./dist/bun/cli.js ./src/utils/image-resize-worker.ts --outfile dist/pi && npm run copy-binary-assets",
		"copy-assets": "node ../../scripts/package-files.mjs copy-coding-assets packages/coding-agent",
		"copy-binary-assets": "node ../../scripts/package-files.mjs copy-coding-binary-assets packages/coding-agent",
		"test": "vitest --run",
		"shrinkwrap": "node ../../scripts/generate-coding-agent-shrinkwrap.mjs",
		"prepublishOnly": "npm run clean && npm run build && npm run shrinkwrap"
	},
	"dependencies": {
		"@odinlabs-ai/pi-agent-core": "0.79.10-odin.1",
		"@odinlabs-ai/pi-ai": "0.79.10-odin.1",
		"@odinlabs-ai/pi-tui": "0.79.10-odin.1",
		"@silvia-odwyer/photon-node": "0.3.4",
		"brace-expansion": "5.0.12",
		"chalk": "5.6.2",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"glob": "13.0.6",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.5",
		"jiti": "2.7.0",
		"minimatch": "10.2.6",
		"proper-lockfile": "4.1.2",
		"semver": "7.8.0",
		"typebox": "1.1.38",
		"undici": "8.10.2",
		"yaml": "2.9.0"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"optionalDependencies": {
		"@mariozechner/clipboard": "0.3.9"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/diff": "7.0.2",
		"@types/hosted-git-info": "3.0.5",
		"@types/ms": "2.1.0",
		"@types/node": "24.12.4",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/odin-labs-ai/pi-mono.git",
		"directory": "packages/coding-agent"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
